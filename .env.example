# Comma-separated Sites/app origins, for example:
# DEXFORGE_ALLOWED_ORIGINS=https://your-site.example
DEXFORGE_ALLOWED_ORIGINS=
DEXFORGE_ENV=local

# Marketplace/payment configuration.
# Keep all Stripe secrets server-side; never expose them in Sites/mobile builds.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DEXFORGE_PAYMENT_SUCCESS_URL=
DEXFORGE_PAYMENT_CANCEL_URL=
# Optional platform fee in basis points. 0 = no platform fee, 500 = 5%.
DEXFORGE_PLATFORM_FEE_BPS=0

# AR provider configuration. Provider tokens stay in native/server configuration,
# never in a public Sites bundle.
DEXFORGE_AR_PROVIDER=provider_neutral
NIANTIC_SPATIAL_TOKEN=
